{
  "name": "mazono-app",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.32.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "PORT=8787 node --disable-warning=ExperimentalWarning --watch server/main.ts",
    "start": "node --disable-warning=ExperimentalWarning server/main.ts",
    "build": "vue-tsc --noEmit && tsc -p server && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit && tsc -p server",
    "lint": "eslint . --max-warnings 0 --no-warn-ignored --cache --cache-strategy content --cache-location node_modules/.cache/eslint --concurrency=auto",
    "postinstall": "simple-git-hooks || true"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.11",
    "@iconify/vue": "^5.0.5",
    "dexie": "^4.4.7",
    "fastify": "^5.12.8",
    "i18next": "^27.1.1",
    "i18next-vue": "^5.4.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.158",
    "@maninak/eslint-config": "^0.7.0",
    "@nuxt/icon": "^2.6.3",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "eslint": "^10.15.0",
    "fake-indexeddb": "^6.2.8",
    "lint-staged": "^17.6.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "simple-git-hooks": {
    "pre-commit": "cd app && npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix --max-warnings 0 --no-warn-ignored --cache --cache-strategy content --cache-location node_modules/.cache/eslint"
  }
}
